# CTFd Configuration
CTFD_TOKEN=
CTFD_COOKIE=

# Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
CTF_HARNESS_CLAUDE_PARTIAL_MESSAGES=1

# Codex Configuration
OPENAI_API_KEY=
CODEX_ACCESS_TOKEN=
CTF_HARNESS_CODEX_MODEL=gpt-5.4

# Kiro Configuration (Amazon Kiro CLI - AWS Bedrock backed)
# Sign in on the host with `kiro-cli login` so ~/.kiro/secrets.json exists
# and ~/.aws/sso/cache/*.json is populated. The harness copies these into the
# per-challenge container so the in-container kiro-cli inherits the same auth.
# Alternatively set KIRO_API_KEY (direct), AWS_BEARER_TOKEN_BEDROCK, or AWS_PROFILE.
KIRO_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_PROFILE=
AWS_REGION=
CTF_HARNESS_KIRO_CONFIG_DIR=
CTF_HARNESS_KIRO_MODEL=claude-sonnet-4.5-v2

# OpenCode Configuration (sst/opencode)
# Sign in on the host with `opencode auth login` so
# ~/.local/share/opencode/auth.json exists, or set an API/OAuth token here.
# OpenCode also falls back to ANTHROPIC_API_KEY / OPENAI_API_KEY set above.
OPENCODE_API_KEY=
OPENCODE_AUTH_TOKEN=
CTF_HARNESS_OPENCODE_HOME=
CTF_HARNESS_OPENCODE_MODEL=claude-sonnet-4-5

# Optional local CLI auth overrides
# Defaults are C:\Users\<you>\.claude and C:\Users\<you>\.codex
CTF_HARNESS_CLAUDE_CONFIG_DIR=
CTF_HARNESS_CODEX_HOME=

# Backend MCP Paths
CTFTOOLKIT_WORKSPACE=workspace
CTFTOOLKIT_DB_PATH=ctf_state.db
CTFTOOLKIT_DOWNLOADS=downloads

# Backend MCP Execution
CTFTOOLKIT_TIMEOUT=300
CTFTOOLKIT_MAX_CONTAINERS=5
CTFTOOLKIT_NO_OUTPUT_TIMEOUT=0
CTFTOOLKIT_MAX_DURABLE_JOBS=3
CTFTOOLKIT_DURABLE_JOB_MAX_HOURS=24
CTFTOOLKIT_AUTO_BUILD=1
CTFTOOLKIT_PRUNE_ON_START=0

# Backend Optional Integrations
SHODAN_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
