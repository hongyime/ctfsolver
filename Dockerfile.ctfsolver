# Dockerfile.ctfsolver — containerised ctfsolver app (dashboard + MCP backend)
#
# This image runs the ctfsolver Streamlit dashboard and/or the MCP stdio/HTTP
# backend. It does NOT contain CTF tool binaries — those live in the separate
# ctf-ai-solver / ctftoolkit/* images built by Dockerfile.ctf-tools and
# docker-compose.yml. This image uses Docker-out-of-Docker (DooD): it talks to
# the host Docker daemon via the bind-mounted socket.
#
# Build:
#   docker build -t ctfsolver:latest -f Dockerfile.ctfsolver .
#
# Run (dashboard, see docker-compose.ctfsolver.yml for the full stack):
#   docker run --rm -it \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /path/to/ctf-workdir:/ctf-workdir \
#     -e CTF_WORKDIR=/ctf-workdir \
#     -p 8501:8501 -p 8000:8000 \
#     ctfsolver:latest

FROM python:3.12-slim AS dependencies

# System deps: libmagic (python-magic on non-Windows), git for any VCS ops
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv — the project's package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/opt/venv/bin:/root/.cargo/bin:/root/.local/bin:${PATH}"
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy

WORKDIR /ctfsolver

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock ./

# Sync deps (no dev group, no editable install)
RUN uv sync --no-dev --frozen --no-cache

RUN useradd -u 1000 -m appuser

# Expose Streamlit dashboard and MCP HTTP backend
EXPOSE 8501 8000

ENV PYTHONUTF8=1
ENV PYTHONPATH=/ctfsolver/src
# CTF_WORKDIR must be supplied at runtime via -e or docker-compose env
ENV CTF_WORKDIR=/ctf-workdir
ENV CTFTOOLKIT_WORKSPACE=/ctf-workdir

FROM dependencies AS source
# Application source is a dependency-cached snapshot; dev Watch supplies later edits.
COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser schema/ ./schema/
COPY --chown=appuser:appuser skills/ ./skills/
COPY --chown=appuser:appuser docker/ ./docker/
COPY --chown=appuser:appuser docs/ ./docs/
COPY --chown=appuser:appuser toolkit_manifest.json ./
COPY --chown=appuser:appuser streamlit_app.py main.py ./

# Workspace placeholder — actual workdir is bind-mounted at runtime
RUN mkdir -p /ctf-workdir /ctfsolver/logs \
    && chown -R appuser:appuser /ctf-workdir /ctfsolver



FROM dependencies AS dev
# Install dev dependencies before source so ordinary edits reuse this layer.
RUN uv pip install --python /opt/venv/bin/python --no-cache watchfiles==1.3.0
RUN mkdir -p /ctf-workdir && chown appuser:appuser /ctf-workdir /ctfsolver
COPY --from=source --chown=appuser:appuser /ctfsolver /ctfsolver
USER appuser
ENV HOME=/home/appuser
CMD ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.fileWatcherType=poll", "--server.runOnSave=true"]

FROM source AS production
# Default: start the Streamlit dashboard
# Override CMD to run the MCP backend instead:
#   docker run ... ctfsolver:latest python -m ctf_core.server
CMD ["streamlit", "run", "streamlit_app.py", \
     "--server.address=0.0.0.0", "--server.port=8501"]
