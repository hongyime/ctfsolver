FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    binutils \
    binutils-multiarch \
    binwalk \
    build-essential \
    ca-certificates \
    checksec \
    clang \
    cmake \
    curl \
    exiftool \
    file \
    foremost \
    g++-multilib \
    gcc-multilib \
    gdb \
    gdbserver \
    git \
    hashcat \
    imagemagick \
    iproute2 \
    iputils-ping \
    john \
    jq \
    ltrace \
    make \
    nasm \
    net-tools \
    netcat-openbsd \
    nmap \
    nodejs \
    npm \
    patchelf \
    python3 \
    python3-dev \
    python3-pip \
    python3-pwntools \
    python3-requests \
    python3-venv \
    ruby \
    socat \
    strace \
    sudo \
    tcpdump \
    tmux \
    tshark \
    unzip \
    vim \
    wget \
    whois \
    xxd \
    zip \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && for package in gobuster hydra nikto radare2 sqlmap wfuzz wordlists; do \
        apt-get install -y --no-install-recommends "$package" || true; \
    done \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex opencode-ai

# Kiro CLI (Amazon Kiro - AWS Bedrock backed). No public npm package exists;
# Amazon distributes it as a signed tarball. Pass the URL at build time:
#   docker build --build-arg KIRO_CLI_URL=https://.../kiro-cli-linux-x86_64.tar.gz ...
# If unset, the build skips the install with a warning and Kiro agents will
# fail at runtime with a "kiro-cli not found" message that points here.
ARG KIRO_CLI_URL=""
RUN if [ -n "$KIRO_CLI_URL" ]; then \
      set -eux; \
      curl -fsSL "$KIRO_CLI_URL" -o /tmp/kiro-cli.tar.gz; \
      mkdir -p /opt/kiro-cli; \
      tar -xzf /tmp/kiro-cli.tar.gz -C /opt/kiro-cli; \
      kiro_bin="$(find /opt/kiro-cli -maxdepth 4 -type f -name kiro-cli | head -n1)"; \
      if [ -z "$kiro_bin" ]; then echo "kiro-cli binary not found in tarball" >&2; exit 1; fi; \
      ln -sf "$kiro_bin" /usr/local/bin/kiro-cli; \
      chmod +x "$kiro_bin"; \
      rm -f /tmp/kiro-cli.tar.gz; \
      kiro-cli --version || true; \
    else \
      echo "[ctf-tools] KIRO_CLI_URL not set; kiro-cli NOT installed. Kiro agents will require a rebuild with --build-arg KIRO_CLI_URL=<url>."; \
    fi
RUN for gem in zsteg one_gadget seccomp-tools; do \
        gem install "$gem" --no-document || true; \
    done

RUN if ! getent group 1000 >/dev/null; then groupadd -g 1000 ctf; fi \
    && if ! id -u 1000 >/dev/null 2>&1; then useradd -u 1000 -g 1000 -m -s /bin/bash ctf; fi \
    && usermod -l ctf "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true \
    && usermod -d /home/ctf -m ctf 2>/dev/null || true \
    && groupmod -n ctf "$(getent group 1000 | cut -d: -f1)" 2>/dev/null || true \
    && echo "ctf ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ctf \
    && chmod 0440 /etc/sudoers.d/ctf

WORKDIR /workspace
USER ctf

CMD ["/bin/bash"]
