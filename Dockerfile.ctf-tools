FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    binutils \
    binutils-multiarch \
    binwalk \
    build-essential \
    ca-certificates \
    checksec \
    clang \
    cmake \
    curl \
    exiftool \
    file \
    foremost \
    g++-multilib \
    gcc-multilib \
    gdb \
    gdbserver \
    git \
    hashcat \
    imagemagick \
    iproute2 \
    iputils-ping \
    john \
    jq \
    ltrace \
    make \
    nasm \
    net-tools \
    netcat-openbsd \
    nmap \
    nodejs \
    npm \
    patchelf \
    python3 \
    python3-dev \
    python3-pip \
    python3-pwntools \
    python3-requests \
    python3-venv \
    ruby \
    ruby-dev \
    socat \
    strace \
    sudo \
    tcpdump \
    tmux \
    tshark \
    unzip \
    vim \
    wget \
    whois \
    xxd \
    zip \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && for package in gobuster hydra nikto radare2 sqlmap wfuzz; do \
        apt-get install -y --no-install-recommends "$package" || true; \
    done \
    && mkdir -p /usr/share/wordlists \
    && if [ ! -f /usr/share/wordlists/rockyou.txt ]; then \
         curl -fsSL -o /tmp/rockyou.txt.tar.gz \
           https://github.com/zacheller/rockyou/raw/master/rockyou.txt.tar.gz \
         && tar -xzf /tmp/rockyou.txt.tar.gz -C /usr/share/wordlists/ \
         && rm -f /tmp/rockyou.txt.tar.gz \
         || echo "[ctf-tools] rockyou.txt fetch failed; add it manually at /usr/share/wordlists/rockyou.txt if needed." >&2; \
       fi \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex opencode-ai

# Kiro CLI (Amazon Kiro - AWS Bedrock backed) via the canonical installer.
# The installer downloads a signed zip from prod.download.cli.kiro.dev, verifies
# its SHA256 against a manifest, and writes kiro-cli into $HOME/.local/bin.
# We move the binaries out of /root (mode 700 blocks non-root users) into
# /opt/kiro-cli/ and symlink them onto PATH so any container user can run them.
# KIRO_CLI_SKIP_SETUP=1 keeps the installer non-interactive; --force skips the
# "existing Amazon Q CLI" auto-update prompt (fresh Docker layer has neither).
RUN set -eux; \
    curl -fsSL https://cli.kiro.dev/install -o /tmp/kiro-cli-install.sh; \
    chmod +x /tmp/kiro-cli-install.sh; \
    KIRO_CLI_SKIP_SETUP=1 bash /tmp/kiro-cli-install.sh --force; \
    rm -f /tmp/kiro-cli-install.sh; \
    mkdir -p /opt/kiro-cli; \
    for bin in kiro-cli kiro-cli-chat kiro-cli-term; do \
      if [ -f "/root/.local/bin/$bin" ]; then \
        mv "/root/.local/bin/$bin" "/opt/kiro-cli/$bin"; \
        chmod 755 "/opt/kiro-cli/$bin"; \
        ln -sf "/opt/kiro-cli/$bin" "/usr/local/bin/$bin"; \
      fi; \
    done; \
    kiro-cli --version

RUN for gem in zsteg one_gadget seccomp-tools; do \
        gem install "$gem" --no-document || true; \
    done

RUN if ! getent group 1000 >/dev/null; then groupadd -g 1000 ctf; fi \
    && if ! id -u 1000 >/dev/null 2>&1; then useradd -u 1000 -g 1000 -m -s /bin/bash ctf; fi \
    && usermod -l ctf "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true \
    && usermod -d /home/ctf -m ctf 2>/dev/null || true \
    && groupmod -n ctf "$(getent group 1000 | cut -d: -f1)" 2>/dev/null || true \
    && echo "ctf ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ctf \
    && chmod 0440 /etc/sudoers.d/ctf

WORKDIR /workspace
USER ctf

CMD ["/bin/bash"]
