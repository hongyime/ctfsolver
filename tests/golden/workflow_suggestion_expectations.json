      "id": "web-hidden-login",
      "input": {
        "description": "Login bypass with SQL syntax error, JWT cookie, and hidden admin endpoint",
        "category": "web",
        "target": "http://127.0.0.1:8080",
        "files": [
          "login_response.html",
          "app_notes.txt"
        ],
        "findings": [
          "SQL syntax near UNION SELECT",
          "toy_jwt",
          "hidden route /admin-preview"
        ]
      },
      "expected_tools_prefix": [
        "run_feroxbuster",
        "run_ffuf",
        "run_sqlmap",
        "run_jwt_tool"
      ],
      "expected_tools_include": [
        "run_nuclei",
        "run_nmap"
      ],
      "expected_categories": {
        "run_feroxbuster": "web",
        "run_ffuf": "web",
        "run_sqlmap": "web",
        "run_jwt_tool": "web"
      }
    },
